{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build C project with debug info",
            "command": "gcc",
            "args": [
            "-g",
            "${file}",
            "-o",
            "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}